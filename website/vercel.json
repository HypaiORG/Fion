{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/zh/privacy",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^\\s*(?:(?![eE][nN](?:[-,;\\s]|$))[^,]*,\\s*)*[zZ][hH](?:[-,;\\s].*|$)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^\\s*(?:(?![eE][nN](?:[-,;\\s]|$))[^,]*,\\s*)*[zZ][hH](?:[-,;\\s].*|$)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/zh/privacy",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
